# Postgres connection string (Neon, Supabase, Vercel Postgres, or your own server)
DATABASE_URL=postgres://user:password@host/dbname

# Set to false only for a local Postgres without SSL
DATABASE_SSL=true

# A long random secret. Required to use the /setup page that creates the first admin.
# You can remove it after the first admin exists.
SETUP_TOKEN=change-me-to-a-long-random-string

# Name shown in the app and on the customer contact form
HELPDESK_NAME=Diall Helpdesk

# Public address of the app, used for customer ticket links (optional on Vercel)
APP_URL=https://help.example.com
